{
  "name": "fhir.js",
  "version": "0.1.0",
  "description": "FHIR javascript client",
  "engines": {
    "node": ">=14.0.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/FHIR/fhir.js"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "devDependencies": {
    "abort-controller": "^3.0.0",
    "babel-polyfill": "^6.26.0",
    "chance": "^1.1.11", 
    "coffee-loader": "^1.0.1",
    "coffeescript": "^2.7.0",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coffee-preprocessor": "^1.0.1",
    "karma-mocha": "^2.0.1",
    "karma-webpack": "^5.0.0",
    "mocha": "^10.2.0",
    "rimraf": "^5.0.1",
    "typescript": "^5.1.6",
    "webpack": "^5.88.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "whatwg-fetch": "^3.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:FHIR/fhir.js.git"
  },
  "scripts": {
    "test": "mocha --require coffeescript/register",
    "test:watch": "mocha --require coffeescript/register --watch",
    "integrate": "karma start --single-run",
    "integrate:watch": "karma start",
    "all-tests": "npm run test && npm run integrate",
    "webpack": "webpack --progress",
    "webpack:watch": "webpack --progress --watch",
    "coffee": "coffee --output lib --compile src",
    "coffee:watch": "coffee --output lib --compile --watch src",
    "build": "rimraf dist lib && npm run webpack && npm run coffee",
    "prepare": "npm run build",
    "prepublishOnly": "npm run all-tests"
  },
  "keywords": [
    "fhir",
    "FHIR"
  ],
  "authors": [
    "Maksym Bodnarchuk <bodnarchuk@gmail.com>",
    "Nikolay Ryzhikov <niquola@gmail.com>",
    "Josh Mandel <joshua.mandel@childrens.harvard.edu>",
    "Pavel Bubentsov <bazzy.bazzy@gmail.com>"
  ],
  "author": "Maksym Bodnarchuk <bodnarchuk@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/FHIR/fhir.js/issues"
  },
  "homepage": "https://github.com/FHIR/fhir.js",
  "dependencies": {
    "merge": "^2.1.1",
    "node-fetch": "^3.3.1"
  },
  "peerDependencies": {
    "angular": ">=1.8.0",
    "jquery": ">=3.0.0"
  },
  "optionalDependencies": {
    "@types/fhir": "^0.0.37"
  },
  "files": [
    "dist",
    "lib",
    "src",
    "fhir.d.ts"
  ],
  "types": "./fhir.d.ts",
  "main": "src/adapters/node",
  "browser": "src/adapters/native",
  "module": "src/adapters/native"
}
